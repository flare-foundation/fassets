{
  "name": "@flarenetwork/fasset",
  "version": "1.3.1",
  "description": "Smart contracts implementing FAsset system.",
  "main": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flare-foundation/fassets.git"
  },
  "author": "Flare Foundation",
  "license": "MIT",
  "directories": {},
  "engines": {
    "node": "^24.0.0"
  },
  "files": [
    "artifacts",
    "contracts"
  ],
  "scripts": {
    "---------TEST---SCRIPTS": "",
    "test": "env NODE_OPTIONS=\"--stack-trace-limit=100\" pnpm hardhat test",
    "coverage": "env NODE_OPTIONS=\"--max_old_space_size=8192 --stack-trace-limit=100\" pnpm hardhat coverage --testfiles",
    "test-with-coverage": "pnpm clean && pnpm compile && pnpm coverage \"test/unit test/integration\"",
    "cov": "pnpm coverage",
    "testHH": "tsc && pnpm hardhat test \"test/{unit,integration}/**/*.ts\"",
    "test_unit_hh": "env TEST_PATH=./test/unit pnpm hardhat test",
    "test_integration_hh": "env TEST_PATH=./test/integration pnpm hardhat test",
    "test_e2e": "pnpm fasset_simulation",
    "fasset_simulation": "pnpm test test/e2e-simulation/fasset/FAssetSimulation.ts",
    "tsrun": "pnpm ts-node --files=./type-extensions.ts",
    "---------COMPILE---SCRIPTS": "",
    "clean": "env rm -rf cache artifacts cache-forge artifacts-forge build build-info typechain typechain-truffle",
    "clean-all": "pnpm clean && env rm -rf node_modules/* node_modules/.*",
    "compile": "pnpm hardhat compile && pnpm typechain-truffle-v5",
    "c": "pnpm compile",
    "cl": "pnpm compile && pnpm lint",
    "lint": "pnpm solhint \"contracts/**/*.sol\"",
    "lint-forge": "pnpm solhint \"test-forge/**/*.sol\"",
    "solhint-watch": "node scripts/solhint-watch.js",
    "typechain-truffle-v5": "pnpm typechain --target=truffle-v5 --out-dir typechain-truffle \"artifacts/!(build-info)/**/+([a-zA-Z0-9_]).json\"",
    "size": "pnpm hardhat size-contracts",
    "flatten": "pnpm hardhat flatten",
    "install-slither": "which slither > /dev/null || PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install slither-analyzer",
    "slither": "pnpm install-slither; rm -f ./slither.json 2> /dev/null; slither . --json=./slither.json 2> /dev/null || true; node scripts/slither-parse.js ./slither.json",
    "slither-show-stderr": "pnpm install-slither; rm -f ./slither.json 2> /dev/null; slither . --json=./slither.json || true; node scripts/slither-parse.js ./slither.json",
    "ts-compile-watch": "tsc --watch --noEmit",
    "eslint": "eslint",
    "generate-json-schema": "typescript-json-schema --noExtraProps --required --strictNullChecks",
    "generate-parameter-schema": "pnpm generate-json-schema deployment/lib/asset-manager-parameters.ts AssetManagerParameters -o deployment/config/asset-manager-parameters.schema.json",
    "---------DEPLOY---SCRIPTS": "",
    "console": "pnpm hardhat console --no-compile --network",
    "---------DEPLOY---SCRIPTS---HARDHAT": "",
    "local": "env DEPLOY_PROFILE=hardhat pnpm hardhat --network local",
    "full-deploy-hardhat": "pmpm local deploy-price-reader-v2 && pnpm local run deployment/test/scripts/mock-set-prices.ts && pnpm local deploy-minting-tag-manager && pnpm local deploy-asset-manager-dependencies --all && pnpm local deploy-asset-managers --deploy-controller --all",
    "full-deploy-hardhat-test": "pnpm local test --no-compile deployment/test/test-deployed-contracts.ts",
    "mock-deploy-hardhat": "rm -f deployment/deploys/hardhat.json && pnpm local run deployment/test/scripts/mock-deploy-dependencies.ts && pnpm local run deployment/test/scripts/mock-deploy-stablecoins.ts && pnpm full-deploy-hardhat && pnpm full-deploy-hardhat-test",
    "flare-sc-deploy-hardhat": "pnpm local run deployment/test/scripts/mock-deploy-stablecoins.ts && pnpm full-deploy-hardhat && pnpm full-deploy-hardhat-test",
    "---------DEPLOY---SCRIPTS---COSTON": "",
    "coston": "pnpm hardhat --network coston",
    "coston-staging": "env DEPLOY_PROFILE=coston pnpm hardhat --network coston",
    "coston-qa": "env DEPLOY_PROFILE=coston-qa pnpm hardhat --network coston",
    "deploy-mock-stablecoins-coston": "pnpm coston-staging run deployment/test/scripts/mock-deploy-stablecoins.ts",
    "deploy-price-reader-v2-coston": "pnpm coston-staging deploy-price-reader-v2",
    "deploy-dependencies-coston": "pnpm coston-staging deploy-asset-manager-dependencies",
    "deploy-with-controller-coston": "pnpm coston-staging deploy-asset-managers --deploy-controller --all",
    "full-deploy-coston-test": "pnpm coston-staging test --no-compile deployment/test/test-deployed-contracts.ts",
    "---------DEPLOY---SCRIPTS---COSTON2": "",
    "coston2": "pnpm hardhat --network coston2",
    "coston2-public": "env DEPLOY_PROFILE=coston2 pnpm hardhat --network coston2",
    "coston2-staging": "env DEPLOY_PROFILE=coston2-staging pnpm hardhat --network coston2",
    "coston2-qa": "env DEPLOY_PROFILE=coston2-qa pnpm hardhat --network coston2",
    "---------DEPLOY---SCRIPTS---SONGBIRD": "",
    "songbird": "env DEPLOY_PROFILE=songbird pnpm hardhat --network songbird",
    "---------DEPLOY---SCRIPTS---FLARE": "",
    "flare": "env DEPLOY_PROFILE=flare pnpm hardhat --network flare",
    "---------INFO---SCRIPTS": "",
    "gas-snapshot": "env CI=true pnpm testHH; pnpm gas-report",
    "gas-report": "ts-node scripts/process-gas-report.ts && cat .gas-report.txt",
    "gas-report-check": "scripts/gas-report-check.sh",
    "gas": "cat .gas-report.txt"
  },
  "dependencies": {
    "@flarenetwork/flare-periphery-contracts": "0.1.53-alpha.0",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@eslint/js": "^9.29.0",
    "@flarenetwork/js-flare-common": "0.0.2",
    "@gnosis.pm/mock-contract": "4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@nomiclabs/hardhat-truffle5": "2.1.2",
    "@nomiclabs/hardhat-web3": "2.1.2",
    "@typechain/truffle-v5": "7.0.0",
    "@types/chai": "5.2.2",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.1",
    "chai": "4.5.0",
    "dotenv": "16.5.0",
    "eslint": "^9.29.0",
    "eth-sig-util": "3.0.1",
    "ethereumjs-util": "7.1.5",
    "glob": "11.0.3",
    "hardhat": "2.29.1",
    "hardhat-contract-sizer": "2.10.1",
    "hardhat-gas-reporter": "1.0.9",
    "intercept-stdout": "0.1.2",
    "lodash": "4.18.1",
    "solhint": "5.2.0",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "typechain": "7.0.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.34.0",
    "typescript-json-schema": "0.59.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
